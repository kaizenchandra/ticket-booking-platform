{
  "uid": "ticketing",
  "title": "Ticketing operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API rate",
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_server_requests_seconds_count[5m])"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API p99",
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Active holds",
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketing_holds_active"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Expiry lag",
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketing_expiry_lag_seconds"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pending payments",
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketing_payment_backlog"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbox pending",
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketing_outbox_backlog"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Waiting room depth",
      "datasource": {
        "type": "prometheus",
        "uid": "ticket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ticketing_waiting_depth"
        }
